# ============ 提示词自动迭代优化智能体 · 后端环境配置示例 ============
# 复制本文件为 .env 并按需填写真实值

# JWT 签名密钥（务必替换为随机长字符串）
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 登录态 Cookie：公网 HTTPS 生产环境置 True（浏览器仅经 HTTPS 传输）；本机/内网 HTTP 保持 False
COOKIE_SECURE=false

# LLM API（OpenAI 兼容，国内直连）
# 说明：base_url 形如 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=qwen-plus

# 数据库文件路径（相对 backend 目录）
DATABASE_URL=sqlite:///./prompt_optimizer.db

# 迭代执行默认参数
VARIANT_GEN_TEMPERATURE=0.8
EXEC_TIMEOUT_SECONDS=60
EXEC_MAX_RETRIES=2